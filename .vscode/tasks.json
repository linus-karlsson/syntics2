{
    "version": "2.0.0",
    "type": "shell",
    "label": "My build",
    "command": "${workspaceFolder}/Commands/build.sh",
    "presentation": {
        "clear": true
    },
    "problemMatcher": {
        "owner": "cpp",
        "fileLocation": [
            "relative",
            "${workspaceFolder}"
        ],
        "pattern": {
            "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "severity": 4,
            "message": 5
        }
    }
}